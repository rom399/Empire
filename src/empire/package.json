{
  "name": "empire-ts",
  "version": "0.1.3",
  "description": "Experimental TypeScript HTTP framework built from scratch on Node's http module, inspired by ASP.NET Core. API may change without notice - not production-ready.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "vitest run",
    "start": "tsx examples/01-basic-server/server.ts",
    "dev": "tsx watch examples/01-basic-server/server.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware",
    "examples": "tsx scripts/run-examples.ts",
    "verify": "npm run typecheck && npm run test && npm run examples",
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run verify && npm run build"
  },
  "keywords": [
    "typescript",
    "http",
    "web-framework",
    "middleware",
    "dependency-injection",
    "aspnet",
    "dotnet"
  ],
  "author": "Roman",
  "license": "MIT",
  "type": "commonjs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rom399/Empire.git"
  },
  "homepage": "https://github.com/rom399/Empire#readme",
  "bugs": {
    "url": "https://github.com/rom399/Empire/issues"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "oxlint": "^1.83.0",
    "oxlint-tsgolint": "^7.0.2001",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "zod": "^4.5.4"
  }
}
