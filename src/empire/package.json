{
  "name": "empire",
  "version": "1.0.0",
  "description": "Empire is a lightweight TypeScript web framework built from scratch using Node.js.",
  "scripts": {
    "test": "vitest run",
    "start": "tsx examples/01-basic-server/server.ts",
    "dev": "tsx watch examples/01-basic-server/server.ts",
    "typecheck": "tsc --noEmit",
    "examples": "tsx scripts/run-examples.ts",
    "verify": "npm run typecheck && npm run test && npm run examples"
  },
  "keywords": [
    "typescript",
    "http",
    "web-framework",
    "middleware"
  ],
  "author": "Roman",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsx": "^4.22.4",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "zod": "^4.4.3"
  }
}
